<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Reading Fun - Vowels</title>
<style>
body{font-family:Arial,sans-serif;background:#FFF3E0;margin:0;padding:20px;text-align:center}
h1{color:#FF6F00;font-size:28px}
.tabs{display:flex;justify-content:center;gap:10px;margin:20px 0}
.tab{padding:12px 22px;border-radius:25px;border:none;font-size:18px;font-weight:bold;cursor:pointer;background:#FFE0B2}
.tab.active{background:#FF9800;color:white}
.card{background:white;border-radius:20px;padding:25px;max-width:500px;margin:auto;box-shadow:0 4px 15px rgba(0,0,0,0.1)}
.word{font-size:42px;font-weight:bold;color:#4A148C;margin:15px 0}
.sentence{font-size:24px;color:#333;line-height:1.5;margin:15px 0}
button.big{padding:14px 25px;font-size:20px;border:none;border-radius:15px;cursor:pointer;margin:8px}
.speak{background:#4CAF50;color:white}
.next{background:#2196F3;color:white}
.score{font-size:18px;color:#FF6F00;margin-top:10px}
</style>
</head>
<body>
<h1>🌈 Reading Fun</h1>
<p>Short Vowels & Long Vowels</p>

<div class="tabs">
<button class="tab active" id="tabShort" onclick="switchMode('short')">Short Vowels</button>
<button class="tab" id="tabLong" onclick="switchMode('long')">Long Vowels</button>
</div>

<div class="card">
<div class="word" id="word">cat</div>
<div class="sentence" id="sentence">The cat sat on the mat.</div>
<button class="big speak" onclick="speak()">🔊 Listen</button>
<button class="big next" onclick="nextSentence()">Next ➡️</button>
<div class="score" id="progress">1 / 8</div>
</div>

<script>
let mode='short';
let index=0;
const data={
short:[
{word:"cat", sentence:"The cat sat on the mat."},
{word:"pen", sentence:"The red pen is in the bag."},
{word:"pig", sentence:"The pig is big and pink."},
{word:"dog", sentence:"The dog runs in the sun."},
{word:"bus", sentence:"The bus is red and big."},
{word:"bed", sentence:"I sleep on my bed."},
{word:"fish", sentence:"The fish swims in the pond."},
{word:"sun", sentence:"The sun is hot today."}
],
long:[
{word:"cake", sentence:"I like to eat cake."},
{word:"bike", sentence:"I ride my bike to school."},
{word:"tree", sentence:"The bird is in the tree."},
{word:"boat", sentence:"The boat is on the sea."},
{word:"cute", sentence:"The cute pup is happy."},
{word:"game", sentence:"Let's play a fun game."},
{word:"nose", sentence:"I can touch my nose."},
{word:"kite", sentence:"My kite flies high."}
]
};
function show(){
let item=data[mode][index];
document.getElementById('word').textContent=item.word;
document.getElementById('sentence').textContent=item.sentence;
document.getElementById('progress').textContent=(index+1)+" / "+data[mode].length;
}
function switchMode(m){
mode=m; index=0;
document.getElementById('tabShort').classList.toggle('active', m==='short');
document.getElementById('tabLong').classList.toggle('active', m==='long');
show();
}
function speak(){
let text=document.getElementById('sentence').textContent;
let u=new SpeechSynthesisUtterance(text);
u.rate=0.8; u.lang='en-US';
speechSynthesis.speak(u);
}
function nextSentence(){
index=(index+1)%data[mode].length;
show();
}
show();
</script>
</body>
</html>
